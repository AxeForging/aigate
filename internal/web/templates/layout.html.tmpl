{{define "layout"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>aigate · dashboard</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23d9531e'/%3E%3Cpath d='M9 23V12l7-4 7 4v11' fill='none' stroke='%23fff7ef' stroke-width='2.6' stroke-linejoin='round'/%3E%3Cpath d='M13 23v-6h6v6' fill='none' stroke='%23fff7ef' stroke-width='2.6'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="#overview" aria-label="aigate dashboard">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7"/><path d="M9 23V12l7-4 7 4v11" /><path d="M13 23v-6h6v6" /></svg>
        <span class="brand-name">aigate</span>
        <span class="brand-sub">Sandbox dashboard</span>
      </a>
      <div class="topbar-actions">
        <span class="status {{if .Initialized}}is-ok{{else}}is-warn{{end}}" title="{{tilde .ConfigPath}}">
          <span class="dot" aria-hidden="true"></span>{{if .Initialized}}Config loaded{{else}}Not initialized — run <code>aigate init</code>{{end}}
        </span>
        <span class="sync-note" data-field="sync-note" aria-live="polite">Loading…</span>
        <button type="button" class="btn" data-action="refresh">Refresh</button>
      </div>
    </div>
    <nav class="tabs" aria-label="Sections">
      <a href="#overview">Overview</a>
      <a href="#decisions">Decisions</a>
      <a href="#identities">Identities</a>
      <a href="#policy">Policy</a>
    </nav>
  </header>

  <main class="page">
    <section id="overview" class="section" aria-labelledby="overview-title">
      <h2 id="overview-title" class="visually-hidden">Overview</h2>
      <div class="stats">
        <article class="card stat">
          <h3>Blocked or flagged</h3>
          <strong data-field="blocked-total">{{.Counters.BlockedTotal}}</strong>
          <p>Rule blocks, judge denials and questions, all time</p>
        </article>
        <article class="card stat">
          <h3>Today</h3>
          <strong data-field="blocked-today">{{.Counters.BlockedToday}}</strong>
          <p>Blocked or flagged since midnight</p>
        </article>
        <article class="card stat">
          <h3>Sessions</h3>
          <strong data-field="runs-total">{{.Counters.RunsTotal}}</strong>
          <p>Sandboxed sessions started</p>
        </article>
        <article class="card latest" aria-labelledby="latest-title">
          <h3 id="latest-title">Latest block <span class="outcome outcome-deny" data-field="latest-badge"{{if not .LastBlocked}} hidden{{end}}>Blocked</span></h3>
          <div data-field="latest-block">
            {{if .LastBlocked}}
            <code class="latest-what">{{.LastBlocked.Command}}</code>
            <p class="latest-why">{{.LastBlocked.Rule}} · {{.LastBlocked.Detail}}</p>
            {{else}}
            <p class="muted">Nothing blocked yet. Blocks from <code>aigate run</code> sessions show up here.</p>
            {{end}}
          </div>
        </article>
      </div>

      <div class="charts">
        <article class="card">
          <header class="card-head">
            <h3>Blocks by rule</h3>
          </header>
          <div class="bars" data-field="bars"></div>
        </article>
        <article class="card">
          <header class="card-head">
            <h3>Activity, last 14 days</h3>
            <ul class="legend" aria-hidden="true">
              <li><span class="swatch swatch-runs"></span>Sessions</li>
              <li><span class="swatch swatch-blocked"></span>Blocks</li>
            </ul>
          </header>
          <div class="spark" data-field="spark" role="img" aria-label="Daily sessions and blocks, last 14 days"></div>
          <div class="spark-axis" data-field="spark-axis" aria-hidden="true"></div>
        </article>
      </div>
    </section>

    <section id="decisions" class="section" aria-labelledby="decisions-title">
      <header class="section-head">
        <div>
          <h2 id="decisions-title">Decisions</h2>
          <p>Every block, judge verdict, override and fallback — newest first.</p>
        </div>
        <output class="count" data-field="filter-count">0 shown</output>
      </header>
      <div class="card">
        <form class="filters" aria-label="Filter decisions" onsubmit="return false">
          <label class="field field-search">
            <span>Search</span>
            <input type="search" data-filter="query" placeholder="Command, file, reason…" autocomplete="off">
          </label>
          <label class="field">
            <span>Type</span>
            <select data-filter="kind">
              <option value="">All types</option>
              <option value="blocked">Sandbox / rule blocks</option>
              <option value="judge_decision">Judge verdicts</option>
              <option value="judge_override">Overrides</option>
              <option value="judge_fallback">Judge fallbacks</option>
            </select>
          </label>
          <label class="field">
            <span>Layer</span>
            <select data-filter="layer">
              <option value="">All layers</option>
              <option value="sandbox">Sandbox</option>
              <option value="rule">Rule</option>
              <option value="identity">Identity</option>
              <option value="judge">Judge</option>
            </select>
          </label>
          <label class="field">
            <span>Identity</span>
            <select data-filter="identity">
              <option value="">All identities</option>
            </select>
          </label>
          <button type="button" class="btn btn-quiet" data-action="clear-filters">Clear filters</button>
        </form>
        <div class="decisions" data-list="events" aria-live="polite">
          <div class="empty"><strong>Loading decisions…</strong></div>
        </div>
      </div>
    </section>

    <section id="identities" class="section" aria-labelledby="identities-title">
      <header class="section-head">
        <div>
          <h2 id="identities-title">Identities</h2>
          <p>Each session sees only its own identity's logins, git author and ssh key.</p>
        </div>
      </header>
      <div class="identity-grid" data-list="identities" aria-live="polite">
        <div class="card empty"><strong>Loading identities…</strong></div>
      </div>
    </section>

    <section id="policy" class="section" aria-labelledby="policy-title">
      <header class="section-head">
        <div>
          <h2 id="policy-title">Policy</h2>
          <p>Rules every <code>aigate run</code> session enforces. Change them with <code>aigate allow</code> / <code>aigate deny</code>.</p>
        </div>
      </header>
      <div class="policy-grid">
        <article class="card policy">
          <h3>Hidden files <span class="badge" data-field="rule-read">{{len .Rules.DenyRead}}</span></h3>
          <p class="policy-help">deny_read — shown as blocked inside the sandbox</p>
          <ul data-list="deny-read">{{range .Rules.DenyRead}}<li>{{.}}</li>{{else}}<li class="muted">none</li>{{end}}</ul>
        </article>
        <article class="card policy">
          <h3>Blocked commands <span class="badge" data-field="rule-exec">{{len .Rules.DenyExec}}</span></h3>
          <p class="policy-help">deny_exec — refused before and inside the sandbox</p>
          <ul data-list="deny-exec">{{range .Rules.DenyExec}}<li>{{.}}</li>{{else}}<li class="muted">none</li>{{end}}</ul>
        </article>
        <article class="card policy">
          <h3>Allowed hosts <span class="badge" data-field="rule-net">{{len .Rules.AllowNet}}</span></h3>
          <p class="policy-help">allow_net — every other host is unreachable</p>
          <ul data-list="allow-net">{{range .Rules.AllowNet}}<li>{{.}}</li>{{else}}<li class="muted">any host (no allow_net)</li>{{end}}</ul>
        </article>
        <article class="card policy">
          <h3>Home folders in scope <span class="badge" data-field="rule-scope">{{len .Rules.AllowedPaths}}</span></h3>
          <p class="policy-help">allowed_paths — plus the working folder; the rest of $HOME is hidden</p>
          <ul data-list="allowed-paths">{{range .Rules.AllowedPaths}}<li>{{.}}</li>{{else}}<li class="muted">scope off — all of $HOME is reachable</li>{{end}}</ul>
        </article>
      </div>
      <dl class="paths">
        <div><dt>Config file</dt><dd><code>{{tilde .ConfigPath}}</code></dd></div>
        <div><dt>Audit log</dt><dd><code>{{tilde .AuditPath}}</code></dd></div>
      </dl>
    </section>
  </main>
  <script src="/static/app.js"></script>
</body>
</html>
{{end}}
